# 依赖与构建产物（容器内重新安装/构建）
node_modules
.next
out
build

# 版本控制与会话产物
.git
.gitignore
.claude
.z-ai-config
.zscripts

# 用户数据：绝不打进镜像（运行时挂载持久卷）
data
data-backup*
upload
backups

# 测试资产与脚本产物
scripts/test-videos
scripts/shots
tool-results
agent-ctx

# 日志与临时文件
*.log
dev.log
server.log

# 环境变量（生产环境变量由 compose/运行时注入）
.env
.env.*

# 本地数据库（脚手架残留，项目未使用）
db
prisma/*.db

# 文档不需要进镜像
*.md
!PROJECT.md
LICENSE
