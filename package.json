{
  "name": "omnicompare",
  "version": "0.3.0",
  "private": true,
  "description": "OmniCompare（灵动对比）：把多个 AI 模型产出的视频、图片与 HTML 页面放进同一矩阵并行对比的对比工作台。",
  "license": "MIT",
  "author": "ChenChen913",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenChen913/omnicompare.git"
  },
  "bugs": {
    "url": "https://github.com/ChenChen913/omnicompare/issues"
  },
  "homepage": "https://github.com/ChenChen913/omnicompare#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/run-with-log.mjs dev.log -- next dev -p 3000",
    "build": "next build && node scripts/copy-standalone.mjs",
    "start": "node scripts/run-with-log.mjs server.log --env NODE_ENV=production --env PORT=3000 -- node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
